# Provedor do modelo: OpenRouter tem prioridade se a chave existir; LLM_PROVIDER força (openrouter | openai)
LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Leitura Minha
OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.4-nano
# com crédito carregado: OPENROUTER_MODEL=openai/gpt-5.6-terra e OPENROUTER_FALLBACK_MODELS=openai/gpt-5.4-mini
LLM_MAX_OUTPUT_TOKENS=2048
# OpenAI direta (alternativa)
OPENAI_API_KEY=
COPILOT_MODEL=openai:gpt-5.6-terra
VISION_MODEL=gpt-5.6-terra
# opcional
EXA_API_KEY=

# Voz: modelo multimodal da OpenRouter que aceita áudio na entrada (input_audio) e structured outputs
VOZ_MODEL=google/gemini-3.5-flash-lite
VOZ_FALLBACK_MODELS=google/gemini-3.1-flash-lite,openai/gpt-audio-mini
